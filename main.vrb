\frametitle{\textcolor {activecolor}{The raygen program II -- Writing the bitset}}
\begin{columns}[T]
    \begin{column}{0.52\textwidth}
      \small
      \begin{lstlisting}
if (!occluded)
  atomicOr(&params.bits[k >> 5],
           1u << (k & 31));
      \end{lstlisting}
      \vspace{1mm}
      \begin{itemize}
        \item Ray $k$ $\to$ bit $k$: word \texttt{k>>5}, position \texttt{k\&31}.
        \item $N=5$: all 10 rays share \texttt{bits[0]}.
        \item Plain \verb+|=+ is read $\to$ modify $\to$ write\\
              $\Rightarrow$ \alert{data race, lost bits}.
        \item \texttt{atomicOr}: read-modify-write as one \alert{indivisible} operation.
        \item Each thread sets \alert{only its own bit}, and OR is commutative\\
              $\Rightarrow$ deterministic result.
        \item Blocked ray: no call, the bit stays 0.
      \end{itemize}
    \end{column}
    \begin{column}{0.46\textwidth}
      \small
      \textbf{Without atomics}
      \begin{center}
      \begin{tabular}{ll}
        T0: reads \texttt{0000} & T1: reads \texttt{0000}\\
        T0: writes \texttt{0001} & T1: writes \texttt{0010}\\
      \end{tabular}\\[1mm]
      \alert{$\Rightarrow$ \texttt{0010}: bit 0 is lost}
      \end{center}
      \vspace{2mm}
      \textbf{With \texttt{atomicOr}}
      \begin{center}
      \begin{tabular}{ll}
        T0: \texttt{atomicOr(0001)} & $\to$ \texttt{0001}\\
        T1: \texttt{atomicOr(0010)} & $\to$ \texttt{0011}\\
      \end{tabular}\\[1mm]
      \textcolor{green!50!black}{$\Rightarrow$ nothing is lost}
      \end{center}
      \vspace{2mm}
      \textbf{Result on the example} (\texttt{bits[0]}, bits 9..0)
      \begin{center}
        \texttt{1110111011}
      \end{center}
      \centering bits 2 and 6 stay at \alert{0}.
    \end{column}
  \end{columns}
