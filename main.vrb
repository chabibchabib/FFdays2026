\frametitle{\textcolor {activecolor}{Build chain}}
\begin{center}
  \begin{tikzpicture}[node distance=1.3cm,font=\normalsize]
    \node[box=rtorange,text width=2.6cm] (cu) {\texttt{.cu}\\(raygen, miss)};
    \node[box=rtorange,text width=2.6cm,right=of cu] (ptx) {\texttt{.ptx}};
    \node[box=rtblue,text width=2.6cm,below=0.9cm of cu] (cpp) {\texttt{.cpp}\\(host + \texttt{FreeFEM} glue)};
    \node[box=rtblue,text width=2.6cm,right=of cpp] (so) {plugin \texttt{.so}};
    %\node[box=rtgreen,text width=2.6cm,right=2cm of ptx] (run) {run: \texttt{FreeFem++ script.edp}};
    \node[box=rtgreen,text width=2.6cm] (run) at ([xshift=4cm,yshift=-0.85cm]ptx) {run: \texttt{FreeFem++ script.edp}};
    \draw[arr] (cu)--node[above, yshift = 0.4cm]{\texttt{nvcc -ptx}}(ptx);
    \draw[arr] (cpp)--node[above,yshift =-1cm]{\texttt{FF} + OptiX headers}(so);
    \draw[arr] (ptx)--(run); \draw[arr] (so)--(run);
  \end{tikzpicture}
  \end{center}
  \begin{itemize}\setlength\itemsep{0.4em}
    \item Requirements: OptiX SDK headers, CUDA toolkit, \texttt{FreeFEM++} plugin toolchain.
  \begin{lstlisting}[language=C++,basicstyle=\fontsize{6}{5}\selectfont\ttfamily]
    #include <cuda_runtime.h>
    #include <optix.h>
    #include <optix_stubs.h>
    #include <optix_function_table_definition.h>
  \end{lstlisting}
    \item The \texttt{.ptx} must exist in the working directory, with the name of the compiled \texttt{.cu}.
    \begin{lstlisting}[language=C++,basicstyle=\fontsize{7}{6}\selectfont\ttfamily]
    nvcc -ptx  -I"PATH/OPTIX/include" xxxxxx.cu -o xxxxxx.ptx
    \end{lstlisting}

  \item Once the \texttt{.ptx} file is generated, the \texttt{.cpp} one is compiled using the following command:
    \begin{lstlisting}[language=C++,basicstyle=\fontsize{7}{6}\selectfont\ttfamily]

  ff-c++ -I"\$PATH/OPTIX/include" -I/PATH/cuda/include     -L/PATH/cuda/lib64 -lcudart -lcuda -ldl xxx.cpp
    \end{lstlisting}
  \end{itemize}

