% motivation_figure.tex -- to be included with \input{motivation_figure}
% Requires: \usepackage{tikz} and \usetikzlibrary{arrows.meta, calc, patterns}
 
\begin{tikzpicture}[>=Stealth, scale=0.95]
 
  % --- Surface A (bottom) : meshed boundary, elements of size 1
  \draw[very thick, gray!70!black] (0,0) -- (4,0);
  \foreach \x in {0,1,2,3,4} \draw[thick, gray!70!black] (\x,0.12) -- (\x,-0.12);
  \node[below, font=\footnotesize] at (2,-0.2) {meshed surface $\Gamma_A$};
 
  % --- Surface B (top)
  \draw[very thick, gray!70!black] (2,3.5) -- (6,3.5);
  \foreach \x in {2,3,4,5,6} \draw[thick, gray!70!black] (\x,3.62) -- (\x,3.38);
  \node[above, font=\footnotesize] at (4,3.7) {meshed surface $\Gamma_B$};
 
  % --- Obstacle (another part of the geometry)
  \fill[pattern=north east lines, pattern color=gray!60] (3.2,1.2) rectangle (4.6,2.2);
  \draw[thick, gray!70!black] (3.2,1.2) rectangle (4.6,2.2);
  \node[font=\footnotesize, fill=white, inner sep=1pt] at (3.9,1.7) {obstacle};
 
  % --- Highlighted elements
  \fill[blue!50, opacity=0.6] (1,-0.07) rectangle (2,0.07);       % A_i (ray 1)
  \fill[blue!50, opacity=0.6] (3,3.43) rectangle (4,3.57);        % B_j (ray 1)
  \fill[red!50,  opacity=0.6] (2,-0.07) rectangle (3,0.07);       % A_k (ray 2)
  \fill[red!50,  opacity=0.6] (5,3.43) rectangle (6,3.57);        % B_l (ray 2)
 
  % --- Ray 1 : visible
  \draw[very thick, green!50!black, ->] (1.5,0) -- (3.5,3.5);
  \node[green!50!black, font=\footnotesize, left] at (2.55,2.45) {visible, $V=1$};
 
  % --- Ray 2 : blocked (hit point on obstacle: y = 1.2)
  \draw[very thick, red!70!black] (2.5,0) -- (3.5286,1.2);
  \draw[thick, red!70!black, dashed, opacity=0.5] (3.5286,1.2) -- (5.5,3.5);
  \fill[red!70!black] (3.5286,1.2) circle (2.2pt);
  \node[red!70!black, font=\footnotesize, right] at (3.0,0.45) {blocked, $V=0$};
 
  % --- Ray origins
  \fill (1.5,0) circle (1.8pt);
  \fill (2.5,0) circle (1.8pt);
 
\end{tikzpicture}
 