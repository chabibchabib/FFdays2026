\begin{tikzpicture}[>=Stealth, scale=1.0]
 
  % Coordinates
  \coordinate (O) at (0,0);        % ray origin
  \coordinate (H) at (5,2.5);      % hit point
  \coordinate (E) at (7.4,3.7);    % far end (continuation)
  \coordinate (P) at (2.6,1.3);    % generic point on the ray
 

  % Ray: solid up to the hit, dashed afterwards
  %\draw[very thick, blue!70!black, ->] (O) -- (H);
  \draw[thick, blue!70!black, dashed] (O) -- (H);
  \visible<1>{\draw[thick, blue!70!black, dashed] (H) -- (E);}
 
  % Direction vector d
  \draw[very thick, red!70!black, -{Stealth[length=3mm]}] (O) -- (1.6,0.8)
    node[midway, below right, font=\small] {$\mathbf{d}$};
  % P(t)
  \fill (P) circle (0pt)   node[above left, blue!70!black, font=\small] {$P(t)$};

% Origin 
  \fill (O) circle (2.2pt) node[below left] {$\mathbf{o}$};

\visible<2->{ 
  % Surface (seen from the side)
  \draw[very thick, gray!70!black] ($(H)+(-0.45,-1.5)$) -- ($(H)+(0.45,1.5)$)
    node[above, font=\footnotesize, text=gray!70!black] {Surface};
 
  % Normal at the hit point
  \draw[thick, green!50!black, -{Stealth}] (H) -- ($(H)+(-1.25,0.38)$)
    node[above left, font=\small] {$\mathbf{n}$};


  % Points
  \fill[orange!90!black] (H) circle (2.5pt)
    node[below right, font=\small] {$P(t_{\mathrm{hit}})$};
 
  % Brace showing the parameter t_hit
  \draw[decorate, decoration={brace, amplitude=6pt, mirror}, thick]
    (O) -- (H) node[midway, below=8pt, font=\small] {$t_{\mathrm{hit}}$};
 }
 
\end{tikzpicture}